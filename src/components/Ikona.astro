---
// Zestaw ikon SVG w jednym miejscu — styl kreskowy, siatka 24×24, stroke 1.75.
// Powód istnienia: emoji jako ikony renderują się inaczej na każdym systemie
// (na Windowsie kolorowe, na macOS inne kształty), nie dają się pokolorować
// pod motyw i psują rytm typograficzny. Tu wszystko jest jednym systemem.
interface Props {
  nazwa:
    | "dokument"
    | "przypis"
    | "bibliografia"
    | "tabela"
    | "zegar"
    | "ostrzezenie"
    | "sprawdzone"
    | "pobierz"
    | "strzalka"
    | "lupa"
    | "cudzyslow"
    | "link";
  klasa?: string;
}

const { nazwa, klasa = "w-6 h-6" } = Astro.props;

const SCIEZKI: Record<Props["nazwa"], string> = {
  dokument:
    '<path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"/><path d="M9 9h1"/><path d="M9 13h6"/><path d="M9 17h6"/>',
  przypis:
    '<path d="M4 6h16"/><path d="M4 11h10"/><path d="M4 16h7"/><path d="M15.5 15.5h3"/><path d="M17 14v3"/><circle cx="17" cy="16" r="4.5"/>',
  bibliografia:
    '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/><path d="M9 7h7"/><path d="M9 11h5"/>',
  tabela:
    '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M3 15h18"/><path d="M10 4v16"/>',
  zegar: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  ostrzezenie:
    '<path d="M10.3 4.3 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  sprawdzone: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/>',
  pobierz:
    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/>',
  strzalka: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  lupa: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  cudzyslow:
    '<path d="M9 11H5a1 1 0 0 1-1-1V7a3 3 0 0 1 3-3"/><path d="M9 11v3a5 5 0 0 1-5 5"/><path d="M20 11h-4a1 1 0 0 1-1-1V7a3 3 0 0 1 3-3"/><path d="M20 11v3a5 5 0 0 1-5 5"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.1.1l3-3a5 5 0 0 0-7.1-7.1L11.2 4.8"/><path d="M14 11a5 5 0 0 0-7.1-.1l-3 3a5 5 0 0 0 7.1 7.1l1.8-1.8"/>',
};
---

<svg
  class={klasa}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={SCIEZKI[nazwa]}
/>
