---
// Podgląd strony pracy w oprawie kartki — cień, lekki obrót, opcjonalny podpis.
// Obrazy to renderowane strony z tego samego PDF-a, który dostaje kupujący
// (patrz .prace-src/podglady.py), a nie rysunek poglądowy.
//
// Kliknięcie otwiera lightbox z wersją 1800 px (`-duzy.webp` obok małego pliku).
// W siatce podgląd ma ~250 px szerokości — przypisów ani tabel nie da się z niego
// przeczytać, a to one są dowodem jakości produktu, więc powiększenie jest tu
// funkcją sprzedażową, nie ozdobą.
interface Props {
  src: string;
  alt: string;
  podpis?: string;
  obrot?: "lewo" | "prawo" | "brak";
  klasa?: string;
  priorytet?: boolean;
  powieksz?: boolean;
}

const {
  src,
  alt,
  podpis,
  obrot = "brak",
  klasa = "",
  priorytet = false,
  powieksz = true,
} = Astro.props;

const OBROT = {
  lewo: "-rotate-2",
  prawo: "rotate-2",
  brak: "",
}[obrot];

// Konwencja nazw z podglady.py. Gdyby dużego pliku nie było, skrypt lightboxa
// wraca do małego (onerror), więc brak wersji `-duzy` niczego nie psuje.
const duzy = src.replace(/\.webp$/, "-duzy.webp");
---

<figure class={`group ${klasa}`}>
  <div
    class={`relative overflow-hidden rounded-lg bg-white ring-1 ring-gray-900/10 shadow-2xl shadow-gray-900/20 transition-transform duration-300 motion-safe:group-hover:rotate-0 ${OBROT}`}
  >
    {
      powieksz ? (
        <button
          type="button"
          class="mockup-zoom block w-full cursor-zoom-in appearance-none border-0 bg-transparent p-0 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
          data-duzy={duzy}
          data-maly={src}
          data-alt={alt}
          data-podpis={podpis ?? alt}
          aria-label={`Powiększ: ${podpis ?? alt}`}
        >
          <img
            src={src}
            alt={alt}
            loading={priorytet ? "eager" : "lazy"}
            decoding="async"
            width="900"
            height="1273"
            class="block w-full h-auto"
          />
          <span
            class="pointer-events-none absolute right-3 top-3 grid h-9 w-9 place-items-center rounded-full bg-gray-900/70 text-white opacity-0 shadow-lg backdrop-blur-sm transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100"
            aria-hidden="true"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7" />
              <path stroke-linecap="round" d="M20 20l-3.5-3.5M11 8v6M8 11h6" />
            </svg>
          </span>
        </button>
      ) : (
        <img
          src={src}
          alt={alt}
          loading={priorytet ? "eager" : "lazy"}
          decoding="async"
          width="900"
          height="1273"
          class="block w-full h-auto"
        />
      )
    }
    {/* Delikatny cień przy grzbiecie — sugeruje kartkę, nie zrzut ekranu. */}
    <div
      class="pointer-events-none absolute inset-y-0 left-0 w-6 bg-gradient-to-r from-gray-900/10 to-transparent"
      aria-hidden="true"
    >
    </div>
  </div>
  {
    podpis && (
      <figcaption class="mt-3 text-sm text-gray-500 text-center">{podpis}</figcaption>
    )
  }
</figure>

<script>
  // Skrypt jest hoistowany przez Astro i wykonuje się raz na stronę niezależnie
  // od liczby instancji komponentu. Overlay budujemy dopiero przy pierwszym
  // kliknięciu — strony produktowe mają po 5 podglądów, a większość odwiedzin
  // kończy się bez otwarcia żadnego.
  (() => {
    if ((window as any).__mockupZoom) return;
    (window as any).__mockupZoom = true;

    let overlay: HTMLDivElement | null = null;
    let img: HTMLImageElement | null = null;
    let caption: HTMLParagraphElement | null = null;
    let ostatniPrzycisk: HTMLElement | null = null;

    function zbuduj() {
      overlay = document.createElement("div");
      overlay.className =
        "fixed inset-0 z-[100] hidden overflow-auto overscroll-contain bg-gray-950/90 p-4 sm:p-8 backdrop-blur-sm";
      overlay.setAttribute("role", "dialog");
      overlay.setAttribute("aria-modal", "true");
      // `min-w-[560px]` na telefonie robi z overlaya obszar przewijany w poziomie —
      // bez tego podgląd w lightboxie byłby tej samej szerokości co kafelek w siatce
      // (na wąskim ekranie siatka i tak jest jednokolumnowa), czyli bez powiększenia.
      overlay.innerHTML = `
        <button type="button" data-zamknij
          class="fixed right-4 top-4 z-10 grid h-11 w-11 place-items-center rounded-full bg-white/15 text-white transition-colors hover:bg-white/30 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          aria-label="Zamknij powiększenie">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
        <figure class="mx-auto w-full min-w-[560px] max-w-[1100px] cursor-zoom-out">
          <img alt="" class="mx-auto block h-auto w-full rounded-lg bg-white shadow-2xl" />
          <figcaption data-podpis class="mt-4 pb-4 text-center text-sm text-gray-300"></figcaption>
        </figure>`;
      document.body.appendChild(overlay);
      img = overlay.querySelector("img");
      caption = overlay.querySelector("[data-podpis]");

      // Kliknięcie w tło i w sam obraz zamyka — obraz bywa wyższy niż ekran,
      // więc trafienie w tło wymagałoby przewijania do końca.
      overlay.addEventListener("click", (e) => {
        const cel = e.target as HTMLElement;
        if (cel === overlay || cel.closest("[data-zamknij]") || cel.tagName === "IMG") {
          zamknij();
        }
      });
      img?.addEventListener("error", () => {
        const zapas = img?.dataset.maly;
        if (zapas && img && img.src !== zapas) img.src = zapas;
      });
    }

    function otworz(przycisk: HTMLElement) {
      if (!overlay) zbuduj();
      if (!overlay || !img || !caption) return;
      ostatniPrzycisk = przycisk;
      const d = przycisk.dataset;
      img.dataset.maly = d.maly || "";
      img.src = d.duzy || d.maly || "";
      img.alt = d.alt || "";
      caption.textContent = d.podpis || "";
      overlay.classList.remove("hidden");
      document.documentElement.style.overflow = "hidden";
      overlay.scrollTop = 0;
      (overlay.querySelector("[data-zamknij]") as HTMLElement | null)?.focus();
    }

    function zamknij() {
      if (!overlay) return;
      overlay.classList.add("hidden");
      document.documentElement.style.overflow = "";
      ostatniPrzycisk?.focus();
      ostatniPrzycisk = null;
    }

    document.addEventListener("click", (e) => {
      const przycisk = (e.target as HTMLElement)?.closest?.(".mockup-zoom");
      if (przycisk) otworz(przycisk as HTMLElement);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay && !overlay.classList.contains("hidden")) {
        zamknij();
      }
    });
  })();
</script>
