---
// Podgląd strony pracy w oprawie kartki — cień, lekki obrót, opcjonalny podpis.
// Obrazy to renderowane strony z tego samego PDF-a, który dostaje kupujący
// (patrz .prace-src/podglady.py), a nie rysunek poglądowy.
interface Props {
  src: string;
  alt: string;
  podpis?: string;
  obrot?: "lewo" | "prawo" | "brak";
  klasa?: string;
  priorytet?: boolean;
}

const {
  src,
  alt,
  podpis,
  obrot = "brak",
  klasa = "",
  priorytet = false,
} = Astro.props;

const OBROT = {
  lewo: "-rotate-2",
  prawo: "rotate-2",
  brak: "",
}[obrot];
---

<figure class={`group ${klasa}`}>
  <div
    class={`relative overflow-hidden rounded-lg bg-white ring-1 ring-gray-900/10 shadow-2xl shadow-gray-900/20 transition-transform duration-300 motion-safe:group-hover:rotate-0 ${OBROT}`}
  >
    <img
      src={src}
      alt={alt}
      loading={priorytet ? "eager" : "lazy"}
      decoding="async"
      width="900"
      height="1273"
      class="block w-full h-auto"
    />
    {/* Delikatny cień przy grzbiecie — sugeruje kartkę, nie zrzut ekranu. */}
    <div
      class="pointer-events-none absolute inset-y-0 left-0 w-6 bg-gradient-to-r from-gray-900/10 to-transparent"
      aria-hidden="true"
    >
    </div>
  </div>
  {
    podpis && (
      <figcaption class="mt-3 text-sm text-gray-500 text-center">{podpis}</figcaption>
    )
  }
</figure>
