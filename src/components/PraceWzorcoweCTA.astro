---
// src/components/PraceWzorcoweCTA.astro
// Baner i karta sprzedażowa: katalog prac wzorcowych (/prace/) + ebook ogólny.
//
// Od 2026-10-06 zastępuje graficzne CTA do smart-edu.ai (SmartEduCTA full/sidebar).
// Powód: w 90 dni ok. 50 kliknięć do smart-edu dało 4 rejestracje i 0 zł, a własny
// sklep w tym czasie sprzedał 8 zamówień. Link na każdej stronie do własnego katalogu
// jest też mocnym sygnałem wewnętrznym dla /prace/ (fraza „gotowe prace magisterskie”).
//
//   full    — huby: strona główna, /poradniki/, /tematy/, /przykladowe-prace/, metodologia
//   sidebar — kolumna boczna poradników
import { PRACE, CENA_PLN, kierunkiZPracami, praceKierunku, maKategorie, odmien } from "../data/prace";
import { EBOOK_OGOLNY } from "../data/ebooki";

interface Props {
  variant?: "full" | "sidebar";
}
const { variant = "full" } = Astro.props;

const kierunki = kierunkiZPracami()
  .map((k) => ({
    ...k,
    ile: praceKierunku(k.slug).length,
    url: maKategorie(k.slug) ? `/prace/${k.slug}/` : "/prace/",
  }))
  .sort((a, b) => b.ile - a.ile);
const ilePrac = PRACE.length;
const najwiecejStron = Math.max(...PRACE.map((p) => p.stron));
---

{variant === "full" && (
  <div class="rounded-2xl border-2 border-primary-200 bg-gradient-to-br from-indigo-50 via-white to-purple-50 p-6 md:p-10">
    <div class="grid lg:grid-cols-5 gap-8 items-start">
      <div class="lg:col-span-3">
        <p class="text-xs uppercase tracking-wide text-primary-700 font-semibold mb-2">Gotowe prace wzorcowe</p>
        <p class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
          {`${ilePrac} ${odmien(ilePrac, "kompletna praca magisterska", "kompletne prace magisterskie", "kompletnych prac magisterskich")} do adaptacji`}
        </p>
        <p class="text-gray-700 mb-5 max-w-xl">
          Całe prace na konkretnych tematach, do {najwiecejStron} stron, z przypisami wskazującymi
          numer strony w źródle i pełną bibliografią. Zobaczysz, jak wygląda gotowy rozdział
          teoretyczny i badawczy na Twoim kierunku.
        </p>
        <ul class="flex flex-wrap gap-2 mb-6">
          {kierunki.map((k) => (
            <li>
              <a href={k.url} class="inline-block bg-white border border-primary-200 hover:border-primary-400 text-gray-800 hover:text-primary-700 no-underline text-sm font-medium px-3 py-1.5 rounded-full transition-colors">
                {k.nazwa}{" "}<span class="text-gray-500">({k.ile})</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap items-center gap-4">
          <a href="/prace/" class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white no-underline font-semibold py-3 px-6 rounded-xl transition-colors">
            Zobacz gotowe prace →
          </a>
          <span class="text-sm text-gray-600">{CENA_PLN} zł · PDF + Word · pobierasz od razu</span>
        </div>
      </div>

      <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl p-6">
        <p class="text-xs uppercase tracking-wide text-gray-500 font-semibold mb-2">Wolisz napisać sam?</p>
        <p class="font-bold text-gray-900 text-lg mb-2">„{EBOOK_OGOLNY.tytul}”</p>
        <p class="text-sm text-gray-600 mb-4">
          {EBOOK_OGOLNY.stron} stron: od wyboru tematu przez metodologię i analizę wyników po obronę.
          Szablony, checklisty i rozdział o etycznym korzystaniu z AI.
        </p>
        <a href={EBOOK_OGOLNY.href} class="inline-flex items-center gap-2 border-2 border-primary-600 text-primary-700 hover:bg-primary-50 no-underline font-semibold py-2.5 px-5 rounded-xl transition-colors">
          Ebook · {EBOOK_OGOLNY.cena} zł →
        </a>
      </div>
    </div>
  </div>
)}

{variant === "sidebar" && (
  <div class="card border border-primary-100">
    <p class="font-bold text-gray-900 mb-1">Gotowe prace wzorcowe</p>
    <p class="text-sm text-gray-600 mb-4">Kompletne prace magisterskie, PDF + Word, {CENA_PLN} zł:</p>
    <ul class="space-y-1.5 mb-4">
      {kierunki.map((k) => (
        <li>
          <a href={k.url} class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg bg-primary-50/60 hover:bg-primary-100 text-sm text-gray-800 hover:text-primary-700 no-underline transition-colors">
            <span class="font-medium">{k.nazwa}</span>
            <span class="text-gray-500">{`${k.ile} ${odmien(k.ile, "praca", "prace", "prac")}`}</span>
          </a>
        </li>
      ))}
    </ul>
    <a href="/prace/" class="block w-full text-center bg-primary-600 hover:bg-primary-700 text-white no-underline font-semibold py-2.5 px-4 rounded-xl transition-colors">
      Wszystkie prace →
    </a>
  </div>
)}
