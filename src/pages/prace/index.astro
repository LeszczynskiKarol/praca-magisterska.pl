---
// Landing katalogu prac wzorcowych.
// Cel wyszukiwarkowy: „gotowe prace magisterskie”, „prace magisterskie” —
// obie frazy obsługiwała dotąd strona główna z pozycji 50–60 (GSC V–VIII 2026).
//
// UWAGA przy edycji: global.css nadaje h1–h6 kolor text-gray-900, więc na
// ciemnych sekcjach każdy nagłówek MUSI mieć jawne `text-white`. Dziedziczenie
// koloru z rodzica tu nie zadziała.
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Ikona from "../../components/Ikona.astro";
import MockupPracy from "../../components/MockupPracy.astro";
import {
  PRACE,
  KIERUNKI,
  kierunkiZKategoria,
  maKategorie,
  odmien,
  CENA_PLN,
} from "../../data/prace";

const kategorie = kierunkiZKategoria();
const laczniePrac = PRACE.length;
const najdluzsza = Math.max(...PRACE.map((p) => p.stron));
const najkrotsza = Math.min(...PRACE.map((p) => p.stron));
const sumaZrodel = PRACE.reduce((s, p) => s + p.pozycjeBibliografii, 0);
const najwiecejPrzypisow = Math.max(...PRACE.map((p) => p.przypisy));

// Bibliografia z odnośnikami. Liczone przy każdym buildzie z prace.json, a ten
// z samych plików prac — pierwsze oszacowanie „ponad 95%” było o włos za wysokie
// (realnie 94,6%), a taka liczba trafia na stronę sprzedażową.
const zrodelZLinkiem = PRACE.reduce((s, p) => s + p.pozycjeZLinkiem, 0);
const procentZLinkiem = Math.floor((zrodelZLinkiem / sumaZrodel) * 100);
const pracKompletZLinkami = PRACE.filter(
  (p) => p.pozycjeZLinkiem === p.pozycjeBibliografii,
).length;
const bohater = PRACE.find((p) => p.slug === "prokrastynacja-akademicka") ?? PRACE[0];

// Zdania z pierwszej kolumny to realne sformułowania z zapytań w Google
// (GSC, V–VIII 2026) — „praca magisterska psychologia przykład”, „jak napisać
// rozdział metodologiczny”, „ile źródeł w pracy magisterskiej”.
const PROBLEMY = [
  {
    ikona: "lupa" as const,
    cytat: "Nie wiem, jak to ma w ogóle wyglądać",
    opis:
      "Promotor mówi „proszę napisać rozdział teoretyczny”, ale nie pokazuje, " +
      "jak wygląda skończony. Wzory w internecie to trzystronicowe fragmenty " +
      "albo szkielety z samymi nagłówkami.",
    odpowiedz:
      "Dostajesz pracę przeczytaną do końca — od strony tytułowej po bibliografię, " +
      "z widocznym rytmem wywodu w każdym rozdziale.",
  },
  {
    ikona: "przypis" as const,
    cytat: "Znalezienie źródeł zajmuje mi więcej czasu niż pisanie",
    opis:
      "Godzina w bazie, żeby znaleźć jedno zdanie nadające się do zacytowania. " +
      "Potem druga, żeby ustalić, z której strony dokładnie pochodzi.",
    odpowiedz:
      "Każde twierdzenie ma przypis z numerem strony. Otwierasz źródło, " +
      "sprawdzasz powołanie, używasz go we własnym rozdziale.",
  },
  {
    ikona: "tabela" as const,
    cytat: "Nie wiem, jaki test statystyczny zastosować",
    opis:
      "Hipotezy sformułowane, dane zebrane, a rozdział z wynikami stoi. " +
      "Podręczniki tłumaczą testy osobno, nie w kontekście konkretnej hipotezy.",
    odpowiedz:
      "Rozdział badawczy prowadzi od hipotezy do testu i do interpretacji — " +
      "widzisz, co z czego wynika, na tabelach i opisie wyników.",
  },
  {
    ikona: "zegar" as const,
    cytat: "Zostały mi trzy tygodnie",
    opis:
      "Termin oddania blisko, a największy kawałek pracy — teoria z porządnym " +
      "aparatem przypisów — wciąż od zera.",
    odpowiedz:
      "Pliki dostajesz od razu po opłaceniu, w PDF i w Wordzie. " +
      "Bez zapisu na newsletter i bez czekania na maila od człowieka.",
  },
];

const ZASTOSOWANIA = [
  {
    ikona: "dokument" as const,
    tytul: "Wzór struktury",
    opis:
      "Widzisz, w jakiej kolejności prowadzi się wywód: gdzie kończy się teoria, " +
      "jak formułuje się pytania badawcze i hipotezy, co wchodzi do dyskusji wyników. " +
      "Ten szkielet przenosi się na każdy temat w obrębie kierunku.",
  },
  {
    ikona: "bibliografia" as const,
    tytul: "Gotowa bibliografia",
    opis:
      "Od 35 do 42 pozycji dobranych do tematu, z linkami do publikacji. " +
      "Masz od czego zacząć własną kwerendę i wiesz, które prace w tym obszarze " +
      "są cytowane najczęściej.",
  },
  {
    ikona: "przypis" as const,
    tytul: "Baza przypisów",
    opis:
      "Każde twierdzenie ma wskazaną stronę w źródle. Otwierasz publikację, " +
      "czytasz fragment i budujesz na nim własny akapit — z własnym sformułowaniem " +
      "i własnym przypisem.",
  },
  {
    ikona: "lupa" as const,
    tytul: "Inspiracja tematyczna",
    opis:
      "Zawężenie tematu, dobór zmiennych i narzędzi pokazują, jak z szerokiego " +
      "zagadnienia zrobić problem badawczy, który da się opracować i obronić.",
  },
];

const FAQ = [
  {
    pytanie: "Jak szybko dostanę pliki?",
    odpowiedz:
      "Od razu po opłaceniu — na stronie potwierdzenia pojawiają się dwa przyciski, " +
      "osobno PDF i osobno Word. Komplet linków idzie też mailem, więc możesz wrócić " +
      "do pobierania później.",
  },
  {
    pytanie: "W jakim formacie dostaję pliki?",
    odpowiedz:
      "PDF i Word (DOCX) — oba w cenie. PDF ma skład gotowy do druku: Times New " +
      "Roman 12 pkt, interlinia 1,5, margines wewnętrzny pod oprawę, żywa pagina " +
      "i spis treści z numeracją. Word służy do przerabiania treści pod własny temat.",
  },
  {
    pytanie: "Czym to się różni od darmowych wzorów na tej stronie?",
    odpowiedz:
      "Darmowe wzory w sekcji „przykładowa praca” to szkielety z komentarzami — " +
      "pokazują, co gdzie wpisać. Tutaj dostajesz rzecz napisaną do końca na " +
      "konkretnym temacie: " +
      najkrotsza +
      "–" +
      najdluzsza +
      " stron ciągłego wywodu z pełną bibliografią.",
  },
  {
    pytanie: "Skąd wiadomo, że przypisy prowadzą do prawdziwych publikacji?",
    odpowiedz:
      "Bibliografia podaje linki do publikacji, a przypisy — numer strony. " +
      "Możesz otworzyć dowolne źródło i sprawdzić powołanie. Właśnie po to " +
      "podajemy stronę zamiast samego autora i roku.",
  },
  {
    pytanie: "Czy dostanę fakturę?",
    odpowiedz:
      "Tak. Płatność obsługuje Stripe, potwierdzenie zakupu przychodzi mailem " +
      "od razu po transakcji. W sprawie faktury napisz na adres podany w stopce.",
  },
];
---

<Layout
  title={`Gotowe prace magisterskie — ${laczniePrac} wzorów z pełnym aparatem naukowym (PDF + Word)`}
  description={`Katalog wzorcowych prac magisterskich. Każda ${najkrotsza}–${najdluzsza} stron, z przypisami do numeru strony źródła i bibliografią liczącą 35–42 pozycje. PDF i Word za ${CENA_PLN} zł.`}
>
  <Navbar />

  <main class="min-h-screen bg-white">
    <!-- ================= HERO ================= -->
    <section class="relative overflow-hidden bg-gradient-to-br from-indigo-950 via-purple-950 to-indigo-950">
      <!-- Siatka w tle: własny wzór SVG, nie obrazek z zewnątrz -->
      <div class="absolute inset-0 opacity-[0.07]" aria-hidden="true">
        <svg width="100%" height="100%">
          <defs>
            <pattern id="siatka" width="48" height="48" patternUnits="userSpaceOnUse">
              <path d="M48 0H0V48" fill="none" stroke="white" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#siatka)" />
        </svg>
      </div>

      <div class="relative max-w-6xl mx-auto px-4 py-16 md:py-24">
        <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-16 items-center">
          <div>
            <p class="inline-flex items-center gap-2 text-sm font-medium text-indigo-200 bg-white/10 rounded-full px-4 py-1.5 mb-6">
              <Ikona nazwa="dokument" klasa="w-4 h-4" />
              {laczniePrac} prac · psychologia, pielęgniarstwo, pedagogika
            </p>

            <h1 class="text-white text-4xl md:text-5xl lg:text-[3.4rem] font-bold leading-[1.1] mb-6">
              Gotowe prace magisterskie<br class="hidden md:block" />
              do pobrania
            </h1>

            <p class="text-lg md:text-xl text-indigo-100 leading-relaxed mb-8 max-w-xl">
              Kompletne prace po {najkrotsza}–{najdluzsza} stron, napisane na publikacjach
              naukowych. Każde twierdzenie ma przypis z numerem strony źródła, a bibliografia
              liczy od 35 do 42 pozycji z linkami.
            </p>

            <div class="flex flex-wrap items-center gap-4 mb-10">
              <a
                href="#prace"
                class="inline-flex items-center gap-2 bg-white text-indigo-950 hover:bg-indigo-50 font-bold py-4 px-7 rounded-xl transition-colors cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                Zobacz prace
                <Ikona nazwa="strzalka" klasa="w-5 h-5" />
              </a>
              <a
                href="#srodek"
                class="inline-flex items-center gap-2 text-white/90 hover:text-white font-semibold py-4 px-2 transition-colors cursor-pointer"
              >
                Co jest w środku
              </a>
            </div>

            <dl class="grid grid-cols-3 gap-6 max-w-lg border-t border-white/15 pt-6">
              <div>
                <dt class="text-indigo-300 text-sm mb-1">stron</dt>
                <dd class="text-white text-2xl font-bold">{najkrotsza}–{najdluzsza}</dd>
              </div>
              <div>
                <dt class="text-indigo-300 text-sm mb-1">przypisów</dt>
                <dd class="text-white text-2xl font-bold">do {najwiecejPrzypisow}</dd>
              </div>
              <div>
                <dt class="text-indigo-300 text-sm mb-1">źródeł łącznie</dt>
                <dd class="text-white text-2xl font-bold">{sumaZrodel}</dd>
              </div>
            </dl>
          </div>

          <!-- Realne strony dokumentu, nie rysunek poglądowy -->
          <div class="relative hidden sm:block">
            <MockupPracy
              src={bohater.podglad.przypisy!}
              alt="Strona pracy magisterskiej z widocznymi przypisami zawierającymi numer strony źródła"
              obrot="prawo"
              priorytet={true}
              klasa="relative z-10 max-w-sm mx-auto"
            />
            <MockupPracy
              src={bohater.podglad.tytulowa!}
              alt="Strona tytułowa wzorcowej pracy magisterskiej"
              obrot="lewo"
              klasa="absolute -bottom-8 -left-2 w-40 md:w-48 z-20 hidden md:block"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PROBLEM → ODPOWIEDŹ ================= -->
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-2xl mb-14">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 leading-tight">
            Cztery rzeczy, na których zwykle staje pisanie
          </h2>
          <p class="text-lg text-gray-600 leading-relaxed">
            Zdania po lewej to sformułowania, z jakimi ludzie trafiają na tę stronę
            z wyszukiwarki. Po prawej — co konkretnie z tym robi wzór pracy.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {
            PROBLEMY.map((p) => (
              <article class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
                <div class="p-6 md:p-7 border-b border-gray-100">
                  <div class="flex items-start gap-4">
                    <span class="shrink-0 grid place-items-center w-11 h-11 rounded-xl bg-gray-100 text-gray-500">
                      <Ikona nazwa={p.ikona} klasa="w-5 h-5" />
                    </span>
                    <div>
                      <p class="text-lg font-bold text-gray-900 leading-snug mb-2">
                        „{p.cytat}”
                      </p>
                      <p class="text-gray-600 leading-relaxed">{p.opis}</p>
                    </div>
                  </div>
                </div>
                <div class="p-6 md:p-7 bg-indigo-50/60">
                  <div class="flex items-start gap-4">
                    <span class="shrink-0 grid place-items-center w-11 h-11 rounded-xl bg-primary-600 text-white">
                      <Ikona nazwa="sprawdzone" klasa="w-5 h-5" />
                    </span>
                    <p class="text-gray-800 leading-relaxed pt-2">{p.odpowiedz}</p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= CO JEST W ŚRODKU ================= -->
    <!-- Tło szare, nie białe: kartki podglądu są białe i na białym tle
         gubią krawędzie mimo cienia. -->
    <section id="srodek" class="py-16 md:py-24 scroll-mt-20 bg-gray-100/70">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-2xl mb-14">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 leading-tight">
            Co jest w środku
          </h2>
          <p class="text-lg text-gray-600 leading-relaxed">
            Poniżej strony z pliku, który dostajesz — nie wizualizacja, tylko
            zrzuty z gotowego PDF-a.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 md:gap-10 mb-16">
          <MockupPracy
            src={bohater.podglad.tytulowa!}
            alt="Strona tytułowa z polami do uzupełnienia: uczelnia, wydział, promotor"
            podpis="Strona tytułowa — pola do wypełnienia, bez zmyślonych danych"
          />
          <MockupPracy
            src={bohater.podglad.spis!}
            alt="Spis treści pracy magisterskiej z numeracją stron i podrozdziałami"
            podpis="Spis treści — pełna hierarchia rozdziałów i podrozdziałów"
          />
          <MockupPracy
            src={bohater.podglad.tabela!}
            alt="Strona z tabelą zestawiającą dane w pracy magisterskiej"
            podpis="Tabele z podpisami i odwołaniami w tekście"
          />
        </div>

        <!-- Dowód: zbliżenie na aparat przypisów -->
        <div class="rounded-3xl bg-gray-900 overflow-hidden">
          <div class="grid lg:grid-cols-2 gap-0 items-center">
            <div class="p-8 md:p-12">
              <span class="inline-flex items-center gap-2 text-sm font-medium text-indigo-300 bg-white/10 rounded-full px-4 py-1.5 mb-6">
                <Ikona nazwa="przypis" klasa="w-4 h-4" />
                Sedno produktu
              </span>
              <h3 class="text-white text-2xl md:text-3xl font-bold mb-5 leading-tight">
                Każdy przypis wskazuje numer strony w źródle
              </h3>
              <p class="text-gray-300 leading-relaxed mb-5">
                Zapis <code class="text-indigo-300 bg-white/10 rounded px-1.5 py-0.5 text-sm">[13,&nbsp;s.&nbsp;13]</code>
                znaczy: pozycja 13 z bibliografii, strona 13. Otwierasz źródło z linku,
                sprawdzasz zdanie i powołujesz się na nie we własnej pracy.
              </p>
              <p class="text-gray-300 leading-relaxed mb-8">
                Taki przypis promotor sprawdzi w minutę, a ty masz gotowy punkt zaczepienia
                do dalszej lektury. Dlatego liczymy je osobno i podajemy przy każdej pracy.
              </p>
              <ul class="space-y-3">
                {
                  PRACE.slice(0, 3).map((p) => (
                    <li class="flex items-baseline gap-3 text-gray-300">
                      <span class="text-white font-bold tabular-nums w-16 shrink-0">
                        {Math.round((p.przypisyZeStrona / p.przypisy) * 100)}%
                      </span>
                      <span class="text-sm leading-snug">
                        przypisów z numerem strony — {p.tytulKrotki}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="p-6 md:p-10 lg:p-12 lg:pl-0">
              <MockupPracy
                src={bohater.podglad.przypisy!}
                alt="Zbliżenie na akapit pracy z przypisami w formacie numer pozycji i numer strony"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= BIBLIOGRAFIA Z LINKAMI ================= -->
    <section class="py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid lg:grid-cols-[1.05fr_1fr] gap-10 lg:gap-16 items-center">
          <div>
            <span
              class="inline-flex items-center gap-2 text-sm font-medium text-primary-700 bg-primary-50 rounded-full px-4 py-1.5 mb-6"
            >
              <Ikona nazwa="link" klasa="w-4 h-4" />
              Bibliografia, którą sprawdzisz w kwadrans
            </span>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-5 leading-tight">
              {procentZLinkiem}% źródeł ma link prowadzący prosto do publikacji
            </h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-5">
              Na {sumaZrodel} pozycji bibliograficznych w całym katalogu {zrodelZLinkiem}
              ma przy sobie adres — najczęściej numer DOI, czasem odnośnik do repozytorium
              albo do strony czasopisma. Klikasz i od razu, za darmo, masz przed sobą
              komplet danych o źródle: autorów, pełny tytuł, czasopismo, tom, rok, strony.
            </p>
            <p class="text-lg text-gray-700 leading-relaxed mb-8">
              Dzięki temu bibliografię przepisujesz do własnej pracy z pewnością, że każda
              pozycja istnieje i zgadza się co do przecinka. W {pracKompletZLinkami} z
              {" "}{laczniePrac} prac odnośnik ma <strong>każda</strong> pozycja.
            </p>
            <div class="flex flex-wrap gap-3">
              <span
                class="inline-flex items-center gap-2 rounded-xl bg-gray-100 px-4 py-2.5 text-sm text-gray-800"
              >
                <Ikona nazwa="bibliografia" klasa="w-4 h-4 text-primary-700" />
                {sumaZrodel} pozycji w katalogu
              </span>
              <span
                class="inline-flex items-center gap-2 rounded-xl bg-gray-100 px-4 py-2.5 text-sm text-gray-800"
              >
                <Ikona nazwa="link" klasa="w-4 h-4 text-primary-700" />
                {zrodelZLinkiem} z odnośnikiem
              </span>
              <span
                class="inline-flex items-center gap-2 rounded-xl bg-gray-100 px-4 py-2.5 text-sm text-gray-800"
              >
                <Ikona nazwa="przypis" klasa="w-4 h-4 text-primary-700" />
                DOI jako podstawowy format
              </span>
            </div>
          </div>

          <ul class="space-y-3">
            {
              [...PRACE]
                .sort(
                  (a, b) =>
                    b.pozycjeZLinkiem / b.pozycjeBibliografii -
                    a.pozycjeZLinkiem / a.pozycjeBibliografii,
                )
                .slice(0, 6)
                .map((p) => (
                  <li class="flex items-center gap-4 rounded-2xl border border-gray-200 px-5 py-4">
                    <span class="text-2xl font-bold text-primary-700 tabular-nums w-20 shrink-0">
                      {Math.floor((p.pozycjeZLinkiem / p.pozycjeBibliografii) * 100)}%
                    </span>
                    <span class="min-w-0">
                      <span class="block text-sm font-semibold text-gray-900 leading-snug">
                        {p.tytulKrotki}
                      </span>
                      <span class="block text-sm text-gray-600">
                        {p.pozycjeZLinkiem} z {p.pozycjeBibliografii} pozycji z linkiem
                      </span>
                    </span>
                  </li>
                ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ================= JAK WYKORZYSTAĆ ================= -->
    <section class="pb-16 md:pb-24">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-2xl mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 leading-tight">
            Jak wykorzystać te prace
          </h2>
          <p class="text-lg text-gray-600 leading-relaxed">
            Jeden plik odpowiada na kilka różnych potrzeb — zależnie od tego, na jakim
            etapie pisania jesteś.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            ZASTOSOWANIA.map((z) => (
              <article class="rounded-2xl border border-gray-200 p-6 hover:border-primary-400 transition-colors">
                <span class="inline-grid place-items-center w-12 h-12 rounded-xl bg-primary-600 text-white mb-5">
                  <Ikona nazwa={z.ikona} klasa="w-6 h-6" />
                </span>
                <h3 class="text-lg font-bold text-gray-900 mb-3 leading-snug">{z.tytul}</h3>
                <p class="text-gray-700 leading-relaxed text-sm">{z.opis}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= KATALOG ================= -->
    <section id="prace" class="py-16 md:py-20 bg-gray-50 scroll-mt-16">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3 leading-tight">
          Dostępne prace
        </h2>
        <p class="text-lg text-gray-600 mb-12">
          {CENA_PLN} zł za pracę. PDF i Word w komplecie.
        </p>

        <div class="grid md:grid-cols-2 gap-6">
          {
            PRACE.map((p) => (
              <article class="group bg-white rounded-2xl border border-gray-200 hover:border-primary-400 transition-colors overflow-hidden flex flex-col">
                <div class="flex gap-5 p-6">
                  <img
                    src={p.podglad.tytulowa}
                    alt=""
                    loading="lazy"
                    width="900"
                    height="1273"
                    class="hidden sm:block w-24 h-auto self-start rounded ring-1 ring-gray-900/10 shadow-md"
                  />
                  <div class="flex-1 min-w-0">
                    <span class="text-xs uppercase tracking-wide text-primary-700 font-semibold">
                      {KIERUNKI[p.kierunek].nazwa}
                    </span>
                    <h3 class="text-lg font-bold text-gray-900 leading-snug mt-1 mb-3">
                      <a
                        href={p.url}
                        class="hover:text-primary-700 transition-colors cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 rounded"
                      >
                        {p.tytul}
                      </a>
                    </h3>
                    <p class="text-sm text-gray-600 leading-relaxed line-clamp-3">
                      {p.opis}
                    </p>
                  </div>
                </div>
                <div class="flex flex-wrap items-center gap-x-5 gap-y-2 px-6 py-3 border-t border-gray-100 text-sm text-gray-600">
                  <span class="inline-flex items-center gap-1.5">
                    <Ikona nazwa="dokument" klasa="w-4 h-4 text-gray-400" />
                    {p.stron} stron
                  </span>
                  <span class="inline-flex items-center gap-1.5">
                    <Ikona nazwa="przypis" klasa="w-4 h-4 text-gray-400" />
                    {p.przypisy} przypisów
                  </span>
                  <span class="inline-flex items-center gap-1.5">
                    <Ikona nazwa="bibliografia" klasa="w-4 h-4 text-gray-400" />
                    {p.pozycjeBibliografii} źródeł
                  </span>
                </div>

                <div class="mt-auto flex items-center justify-between gap-4 px-6 py-4 border-t border-gray-100 bg-gray-50/70">
                  <a
                    href={p.url}
                    class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white font-semibold py-2.5 px-5 rounded-lg transition-colors cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600"
                  >
                    Zobacz tę pracę
                    <Ikona nazwa="strzalka" klasa="w-4 h-4" />
                  </a>
                  <span class="text-lg font-bold text-gray-900">{CENA_PLN} zł</span>
                </div>
              </article>
            ))
          }
        </div>

        {
          kategorie.length > 0 && (
            <div class="mt-12 flex flex-wrap items-center gap-4">
              <span class="text-gray-600">Przeglądaj według kierunku:</span>
              {kategorie.map((k) => (
                <a
                  href={`/prace/${k.slug}/`}
                  class="inline-flex items-center gap-2 rounded-xl border border-gray-300 bg-white hover:border-primary-500 px-5 py-2.5 font-semibold text-gray-800 transition-colors cursor-pointer"
                >
                  {k.nazwa}
                  <span class="text-gray-400 text-sm">
                    {PRACE.filter((p) => p.kierunek === k.slug).length}
                  </span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <section class="py-16 md:py-24">
      <div class="max-w-3xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-10 leading-tight">
          Pytania, które padają najczęściej
        </h2>
        <div class="divide-y divide-gray-200 border-y border-gray-200">
          {
            FAQ.map((f) => (
              <details class="group py-5">
                <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-semibold text-gray-900 text-lg leading-snug focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 rounded">
                  {f.pytanie}
                  <span class="shrink-0 mt-1 text-gray-400 transition-transform duration-200 motion-safe:group-open:rotate-90">
                    <Ikona nazwa="strzalka" klasa="w-5 h-5" />
                  </span>
                </summary>
                <p class="mt-3 text-gray-700 leading-relaxed pr-8">{f.odpowiedz}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= CTA ================= -->
    <section class="pb-20">
      <div class="max-w-6xl mx-auto px-4">
        <div class="rounded-3xl bg-gradient-to-br from-indigo-950 via-purple-950 to-indigo-950 px-6 py-12 md:px-14 md:py-16 text-center">
          <h2 class="text-white text-3xl md:text-4xl font-bold mb-5 leading-tight">
            {laczniePrac} {odmien(laczniePrac, "praca", "prace", "prac")}, {sumaZrodel} źródeł, PDF i Word
          </h2>
          <p class="text-lg text-indigo-100 mb-8 max-w-2xl mx-auto leading-relaxed">
            Wybierz temat najbliższy własnemu i zobacz spis treści oraz opis, zanim
            zdecydujesz. Pliki dostajesz od razu po opłaceniu.
          </p>
          <a
            href="#prace"
            class="inline-flex items-center gap-2 bg-white text-indigo-950 hover:bg-indigo-50 font-bold py-4 px-8 rounded-xl transition-colors cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            <Ikona nazwa="pobierz" klasa="w-5 h-5" />
            Przejdź do katalogu
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
